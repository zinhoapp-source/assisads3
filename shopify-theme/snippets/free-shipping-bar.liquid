{%- if settings.free_shipping_enabled and settings.free_shipping_threshold > 0 -%}
  {%- liquid
    assign threshold_cents = settings.free_shipping_threshold | times: 100
    assign threshold_cents = threshold_cents | times: cart.currency.rate | round
    assign remaining = threshold_cents | minus: cart.total_price
    if remaining < 0
      assign remaining = 0
    endif
    assign pct = cart.total_price | times: 100 | divided_by: threshold_cents
    if pct > 100
      assign pct = 100
    endif
    assign remaining_money = remaining | money
  -%}
  <div class="ship-bar{% if remaining == 0 %} is-unlocked{% endif %}">
    <p class="ship-bar__text">
      {%- if remaining > 0 -%}
        {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'cart.free_shipping_unlocked_html' | t }}
      {%- endif -%}
    </p>
    <div class="ship-bar__track"><span style="width: {{ pct }}%"></span></div>
  </div>
{%- endif -%}
