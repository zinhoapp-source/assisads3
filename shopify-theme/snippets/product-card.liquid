{%- comment -%}
  Cartão de produto.
  Parâmetros: product, lazy (padrão true)
{%- endcomment -%}
{%- liquid
  assign first_variant = product.selected_or_first_available_variant
  assign second_image = product.media[1]
-%}
<div class="card" data-animate>
  <a href="{{ product.url }}" class="card__media{% if settings.card_show_second_image and second_image %} card__media--hover{% endif %}">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 800 | image_tag:
        widths: '300, 400, 600, 800',
        sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
        class: 'card__img card__img--main',
        loading: 'lazy',
        alt: product.featured_media.alt | default: product.title | escape
      }}
      {%- if settings.card_show_second_image and second_image -%}
        {{ second_image | image_url: width: 800 | image_tag:
          widths: '300, 400, 600, 800',
          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
          class: 'card__img card__img--hover',
          loading: 'lazy',
          alt: ''
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'card__img placeholder' }}
    {%- endif -%}

    <div class="card__badges">
      {%- if product.available == false -%}
        <span class="badge badge--muted">{{ 'products.sold_out' | t }}</span>
      {%- elsif settings.card_show_discount_badge and product.compare_at_price > product.price -%}
        {%- assign percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
        <span class="badge badge--sale">{{ 'products.save' | t: percent: percent }}</span>
      {%- endif -%}
    </div>
  </a>

  <div class="card__info">
    {%- if settings.card_show_rating -%}{% render 'rating', product: product %}{%- endif -%}
    <a href="{{ product.url }}" class="card__title">{{ product.title }}</a>
    {% render 'price', product: product %}

    {%- if settings.card_quick_add and product.available -%}
      {%- if product.has_only_default_variant -%}
        {%- form 'product', product, class: 'card__quick-add' -%}
          <input type="hidden" name="id" value="{{ first_variant.id }}">
          <button type="submit" class="btn btn--small btn--block" data-add-button>
            {% render 'icon', name: 'cart' %} <span>{{ 'products.quick_add' | t }}</span>
          </button>
        {%- endform -%}
      {%- else -%}
        <a href="{{ product.url }}" class="btn btn--small btn--block btn--outline card__quick-add">{{ 'products.choose_option' | t }}</a>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
