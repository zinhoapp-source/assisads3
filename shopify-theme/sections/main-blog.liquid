{%- paginate blog.articles by 12 -%}
<section class="section page-width">
  <h1 class="section__title">{{ blog.title }}</h1>
  <div class="blog-grid">
    {%- for article in blog.articles -%}
      <a href="{{ article.url }}" class="article-card">
        {%- if article.image -%}
          <span class="article-card__media">{{ article.image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: article.title | escape }}</span>
        {%- endif -%}
        <span class="article-card__date">{{ article.published_at | date: format: 'date' }}</span>
        <h2 class="article-card__title">{{ article.title }}</h2>
        <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
      </a>
    {%- endfor -%}
  </div>
  {% render 'pagination', paginate: paginate %}
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
