<section class="section newsletter" style="--nl-bg: {{ section.settings.bg }}; --nl-color: {{ section.settings.color }};">
  <div class="page-width page-width--narrow rich-text" data-animate>
    {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- form 'customer', id: 'newsletter-section', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter-form__row">
          <input type="email" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}" aria-label="{{ 'newsletter.email' | t }}" autocomplete="email">
          <button type="submit" class="btn">{%- if section.settings.button_label != blank -%}{{ section.settings.button_label }}{%- else -%}{{ 'newsletter.subscribe' | t }}{%- endif -%}</button>
        </div>
        {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Get 10% off your first order" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Join our list for your welcome code and exclusive offers.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "GET MY CODE" },
    { "type": "color", "id": "bg", "label": "Fundo", "default": "#111111" },
    { "type": "color", "id": "color", "label": "Texto", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
