<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width page-width--narrow">
    <div class="section__header" data-animate>
      {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="section__subtitle">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="compare" data-animate>
      <div class="compare__row compare__row--head">
        <span></span>
        <span class="compare__us">{{ section.settings.us_label }}</span>
        <span>{{ section.settings.them_label }}</span>
      </div>
      {%- for block in section.blocks -%}
        <div class="compare__row" {{ block.shopify_attributes }}>
          <span class="compare__feature">{{ block.settings.feature }}</span>
          <span class="compare__us">{%- if block.settings.us -%}<i class="compare__yes">{% render 'icon', name: 'check' %}</i>{%- else -%}<i class="compare__no">{% render 'icon', name: 'close' %}</i>{%- endif -%}</span>
          <span>{%- if block.settings.them -%}<i class="compare__yes">{% render 'icon', name: 'check' %}</i>{%- else -%}<i class="compare__no">{% render 'icon', name: 'close' %}</i>{%- endif -%}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tabela comparativa",
  "class": "section-comparison",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Por que somos diferentes?" },
    { "type": "text", "id": "subheading", "label": "Subtítulo" },
    { "type": "text", "id": "us_label", "label": "Nome da sua marca", "default": "Nós" },
    { "type": "text", "id": "them_label", "label": "Concorrência", "default": "Outros" },
    { "type": "checkbox", "id": "alt_bg", "label": "Fundo alternativo", "default": true }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Linha",
      "settings": [
        { "type": "text", "id": "feature", "label": "Característica", "default": "Material premium" },
        { "type": "checkbox", "id": "us", "label": "Nós temos", "default": true },
        { "type": "checkbox", "id": "them", "label": "Outros têm", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabela comparativa",
      "blocks": [
        { "type": "row", "settings": { "feature": "Material premium" } },
        { "type": "row", "settings": { "feature": "Garantia de satisfação" } },
        { "type": "row", "settings": { "feature": "Envio com rastreio" } },
        { "type": "row", "settings": { "feature": "Suporte humanizado" } }
      ]
    }
  ]
}
{% endschema %}
