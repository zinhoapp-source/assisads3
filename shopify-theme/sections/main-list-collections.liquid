<section class="section page-width">
  <h1 class="section__title">{{ section.settings.heading }}</h1>
  <div class="collection-tiles collection-tiles--square">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="collection-tile">
        <span class="collection-tile__media">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 600 | image_tag: widths: '200, 400, 600', sizes: '(min-width: 990px) 20vw, 40vw', loading: 'lazy', alt: collection.title | escape }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </span>
        <span class="collection-tile__title">{{ collection.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Lista de coleções",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Collections" }
  ]
}
{% endschema %}
