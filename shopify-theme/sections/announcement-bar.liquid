{%- if section.blocks.size > 0 -%}
  <div class="announcement-bar announcement-bar--{{ section.settings.style }}" style="--ab-bg: {{ section.settings.bg }}; --ab-color: {{ section.settings.color }};" {{ section.shopify_attributes }}>
    {%- if section.settings.style == 'marquee' -%}
      <div class="announcement-bar__track">
        {%- for i in (1..3) -%}
          <div class="announcement-bar__group" {% if i > 1 %}aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              <span class="announcement-bar__item" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
                {%- else -%}
                  {{ block.settings.text }}
                {%- endif -%}
              </span>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <announcement-rotator class="announcement-bar__rotator">
        {%- for block in section.blocks -%}
          <p class="announcement-bar__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          </p>
        {%- endfor -%}
      </announcement-rotator>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de avisos",
  "class": "section-announcement",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        { "value": "marquee", "label": "Letreiro rolando" },
        { "value": "rotate", "label": "Uma mensagem por vez" }
      ],
      "default": "marquee"
    },
    { "type": "color", "id": "bg", "label": "Fundo", "default": "#111111" },
    { "type": "color", "id": "color", "label": "Texto", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensagem",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "🚚 FREE UK DELIVERY on orders over £50" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
