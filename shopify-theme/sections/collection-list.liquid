<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    <div class="section__header" data-animate>
      {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="collection-tiles collection-tiles--{{ section.settings.style }}">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        <a href="{{ col.url | default: '#' }}" class="collection-tile" data-animate {{ block.shopify_attributes }}>
          <span class="collection-tile__media">
            {%- assign img = block.settings.image | default: col.featured_image -%}
            {%- if img != blank -%}
              {{ img | image_url: width: 600 | image_tag: widths: '200, 400, 600', sizes: '(min-width: 990px) 20vw, 40vw', loading: 'lazy', alt: col.title | escape }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </span>
          {%- assign fallback_title = 'collections.category' | t -%}
          <span class="collection-tile__title">{{ block.settings.title | default: col.title | default: fallback_title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lista de categorias",
  "class": "section-collection-list",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Shop by category" },
    {
      "type": "select", "id": "style", "label": "Formato",
      "options": [
        { "value": "circle", "label": "Círculos" },
        { "value": "square", "label": "Quadrados" }
      ],
      "default": "circle"
    },
    { "type": "checkbox", "id": "alt_bg", "label": "Fundo alternativo", "default": false }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Categoria",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "image_picker", "id": "image", "label": "Imagem personalizada" },
        { "type": "text", "id": "title", "label": "Nome personalizado" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lista de categorias",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
