{%- liquid
  assign desktop = section.settings.image
  assign mobile = section.settings.image_mobile | default: desktop
-%}
<section class="hero hero--{{ section.settings.height }} hero--{{ section.settings.align }}" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }}; --hero-color: {{ section.settings.text_color }};">
  <div class="hero__media">
    {%- if desktop != blank -%}
      <picture>
        <source media="(max-width: 749px)" srcset="{{ mobile | image_url: width: 900 }}">
        {{ desktop | image_url: width: 2400 | image_tag:
          widths: '750, 1100, 1500, 1800, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: desktop.alt | escape
        }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </div>
  <div class="page-width hero__content" data-animate>
    {%- if section.settings.eyebrow != blank -%}<p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="hero__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="hero__text rte">{{ section.settings.text }}</div>{%- endif -%}
    <div class="hero__buttons">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--large">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a href="{{ section.settings.button2_link }}" class="btn btn--large btn--outline-light">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner principal",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem (computador)", "info": "Recomendado: 2400 x 1200px" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagem (celular)", "info": "Recomendado: 900 x 1200px" },
    {
      "type": "select", "id": "height", "label": "Altura",
      "options": [
        { "value": "small", "label": "Pequena" },
        { "value": "medium", "label": "Média" },
        { "value": "large", "label": "Grande" }
      ],
      "default": "large"
    },
    {
      "type": "select", "id": "align", "label": "Alinhamento do texto",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "overlay", "label": "Escurecer imagem", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "color", "id": "text_color", "label": "Cor do texto", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeno acima", "default": "NEW ARRIVALS" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Quality you can feel from day one" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Free UK delivery, secure checkout and 14-day hassle-free returns.</p>" },
    { "type": "text", "id": "button_label", "label": "Botão principal", "default": "SHOP NOW" },
    { "type": "url", "id": "button_link", "label": "Link do botão principal" },
    { "type": "text", "id": "button2_label", "label": "Botão secundário" },
    { "type": "url", "id": "button2_link", "label": "Link do botão secundário" }
  ],
  "presets": [{ "name": "Banner principal" }]
}
{% endschema %}
