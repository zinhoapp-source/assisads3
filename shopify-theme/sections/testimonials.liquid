<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    <div class="section__header" data-animate>
      {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="section__subtitle">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="testimonials">
      {%- for block in section.blocks -%}
        <figure class="testimonial" data-animate {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: class: 'testimonial__image', loading: 'lazy', alt: block.settings.author | escape }}
          {%- endif -%}
          <div class="testimonial__body">
            <div class="rating"><span class="rating__stars" style="--rating: {{ block.settings.stars | times: 20 }}%;"><span class="rating__bg">{%- for i in (1..5) -%}{% render 'icon', name: 'star' %}{%- endfor -%}</span><span class="rating__fill">{%- for i in (1..5) -%}{% render 'icon', name: 'star' %}{%- endfor -%}</span></span></div>
            <blockquote class="rte">{{ block.settings.text }}</blockquote>
            <figcaption>
              <strong>{{ block.settings.author }}</strong>
              {%- if block.settings.verified -%}<span class="verified">{% render 'icon', name: 'check' %} Compra verificada</span>{%- endif -%}
            </figcaption>
          </div>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Depoimentos",
  "class": "section-testimonials",
  "max_blocks": 12,
  "settings": [
    { "type": "paragraph", "content": "Use apenas depoimentos reais de clientes. Depoimentos falsos violam o Código de Defesa do Consumidor e as políticas da Shopify." },
    { "type": "text", "id": "heading", "label": "Título", "default": "O que nossos clientes dizem" },
    { "type": "text", "id": "subheading", "label": "Subtítulo" },
    { "type": "checkbox", "id": "alt_bg", "label": "Fundo alternativo", "default": false }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Depoimento",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto do cliente/produto" },
        { "type": "range", "id": "stars", "label": "Estrelas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "richtext", "id": "text", "label": "Depoimento", "default": "<p>Cole aqui o depoimento real de um cliente.</p>" },
        { "type": "text", "id": "author", "label": "Nome", "default": "Nome do cliente" },
        { "type": "checkbox", "id": "verified", "label": "Selo de compra verificada", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Depoimentos",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
