<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    <div class="section__header" data-animate>
      {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="section__subtitle">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <ol class="steps">
      {%- for block in section.blocks -%}
        <li class="step" data-animate {{ block.shopify_attributes }}>
          <div class="step__media">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false, preload: 'metadata', image_size: '800x' }}
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: widths: '300, 500, 800', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: block.settings.title | escape }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
            <span class="step__number">{{ forloop.index }}</span>
          </div>
          <h3 class="step__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<div class="rte step__text">{{ block.settings.text }}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Como funciona (passos)",
  "class": "section-steps",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "How it works" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Results in three simple steps" },
    { "type": "checkbox", "id": "alt_bg", "label": "Fundo alternativo", "default": false }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Passo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem ou GIF" },
        { "type": "video", "id": "video", "label": "Ou vídeo curto (loop sem som)" },
        { "type": "text", "id": "title", "label": "Título", "default": "Step title" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Describe this step in one or two sentences.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Como funciona (passos)",
      "blocks": [
        { "type": "step", "settings": { "title": "Unbox it" } },
        { "type": "step", "settings": { "title": "Use it" } },
        { "type": "step", "settings": { "title": "Love the results" } }
      ]
    }
  ]
}
{% endschema %}
