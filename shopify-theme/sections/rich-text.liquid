<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width page-width--narrow rich-text" data-animate>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn btn--large">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Texto",
  "class": "section-rich-text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeno acima" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tell your brand story" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Share your mission, your values and what makes your store special.</p>" },
    { "type": "text", "id": "button_label", "label": "Botão" },
    { "type": "url", "id": "button_link", "label": "Link do botão" },
    { "type": "checkbox", "id": "alt_bg", "label": "Fundo alternativo", "default": false }
  ],
  "presets": [{ "name": "Texto" }]
}
{% endschema %}
