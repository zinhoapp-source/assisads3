{%- assign collection = section.settings.collection -%}
<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    <div class="section__header" data-animate>
      {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="section__subtitle">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="product-grid product-grid--{{ section.settings.columns }}{% if section.settings.mobile_slider %} product-grid--slider{% endif %}">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="card">
            <div class="card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'card__img placeholder' }}</div>
            <div class="card__info"><p class="card__title">{{ 'products.sample_title' | t }}</p><div class="price price--sale"><span class="price__current">{{ 2999 | money }}</span> <s class="price__compare">{{ 4999 | money }}</s></div></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and collection != blank and collection.products_count > section.settings.limit -%}
      <div class="section__footer">
        <a href="{{ collection.url }}" class="btn btn--outline">{{ 'general.view_all' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Coleção em destaque",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Best sellers" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Our customers' favourites" },
    { "type": "collection", "id": "collection", "label": "Coleção" },
    { "type": "range", "id": "limit", "label": "Quantidade de produtos", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Colunas no computador", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "mobile_slider", "label": "Carrossel no celular", "default": true },
    { "type": "checkbox", "id": "show_view_all", "label": "Botão \"Ver tudo\"", "default": true },
    { "type": "checkbox", "id": "alt_bg", "label": "Fundo alternativo", "default": false }
  ],
  "presets": [{ "name": "Coleção em destaque" }]
}
{% endschema %}
