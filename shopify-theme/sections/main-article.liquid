<article class="section page-width page-width--narrow">
  <a href="{{ blog.url }}" class="back-link">{% render 'icon', name: 'arrow-left' %} {{ 'blogs.back' | t }}</a>
  <h1 class="section__title">{{ article.title }}</h1>
  <p class="article__meta">{{ article.published_at | date: format: 'date' }} · {{ 'blogs.by' | t: author: article.author }}</p>
  {%- if article.image -%}
    <div class="article__image">{{ article.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 800px, 100vw', alt: article.title | escape }}</div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
</article>

{% schema %}
{
  "name": "Artigo",
  "settings": []
}
{% endschema %}
