{%- if section.settings.end_date != blank -%}
<countdown-timer class="section countdown-banner" data-end="{{ section.settings.end_date }}" style="--cb-bg: {{ section.settings.bg }}; --cb-color: {{ section.settings.color }};" hidden>
  <div class="page-width countdown-banner__inner">
    <div>
      {%- if section.settings.heading != blank -%}<h2 class="countdown-banner__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="countdown-banner__time">
      <span><b data-days>00</b><small>{{ 'countdown.days' | t }}</small></span>
      <span><b data-hours>00</b><small>{{ 'countdown.hours' | t }}</small></span>
      <span><b data-minutes>00</b><small>{{ 'countdown.minutes' | t }}</small></span>
      <span><b data-seconds>00</b><small>{{ 'countdown.seconds' | t }}</small></span>
    </div>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn btn--large btn--accent">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</countdown-timer>
{%- endif -%}

{% schema %}
{
  "name": "Contador de promoção",
  "class": "section-countdown",
  "settings": [
    { "type": "text", "id": "end_date", "label": "Data de término", "info": "Formato: 2026-12-31T23:59. A seção some sozinha quando a promoção acabar." },
    { "type": "text", "id": "heading", "label": "Título", "default": "BLACK FRIDAY: up to 50% OFF" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Don't miss out — ends soon." },
    { "type": "text", "id": "button_label", "label": "Botão", "default": "SHOP THE SALE" },
    { "type": "url", "id": "button_link", "label": "Link do botão" },
    { "type": "color", "id": "bg", "label": "Fundo", "default": "#E11D48" },
    { "type": "color", "id": "color", "label": "Texto", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Contador de promoção" }]
}
{% endschema %}
