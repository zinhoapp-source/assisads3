<section class="section section--tight{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    <ul class="trust-row">
      {%- for block in section.blocks -%}
        <li class="trust-row__item" data-animate {{ block.shopify_attributes }}>
          <span class="trust-row__icon">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {% render 'icon', name: block.settings.icon %}
            {%- endif -%}
          </span>
          <span>
            <strong>{{ block.settings.title }}</strong>
            {%- if block.settings.text != blank -%}<small>{{ block.settings.text }}</small>{%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Selos de confiança",
  "class": "section-trust",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "alt_bg", "label": "Fundo alternativo", "default": true }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Selo",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Ícone",
          "options": [
            { "value": "truck", "label": "Caminhão" },
            { "value": "shield", "label": "Escudo" },
            { "value": "lock", "label": "Cadeado" },
            { "value": "return", "label": "Troca" },
            { "value": "chat", "label": "Atendimento" },
            { "value": "gift", "label": "Presente" },
            { "value": "box", "label": "Caixa" },
            { "value": "heart", "label": "Coração" }
          ],
          "default": "truck"
        },
        { "type": "image_picker", "id": "image", "label": "Ou imagem personalizada" },
        { "type": "text", "id": "title", "label": "Título", "default": "Free UK delivery" },
        { "type": "text", "id": "text", "label": "Texto", "default": "On orders over £50" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Selos de confiança",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck", "title": "Free UK delivery", "text": "On orders over £50" } },
        { "type": "badge", "settings": { "icon": "lock", "title": "Secure checkout", "text": "SSL encrypted payments" } },
        { "type": "badge", "settings": { "icon": "return", "title": "Easy returns", "text": "14-day money-back guarantee" } },
        { "type": "badge", "settings": { "icon": "chat", "title": "Real support", "text": "Friendly UK-based team" } }
      ]
    }
  ]
}
{% endschema %}
