<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width page-width--narrow">
    <div class="section__header" data-animate>
      {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="section__subtitle">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="faq">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question }}</span>{% render 'icon', name: 'plus' %}</summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Perguntas frequentes",
  "class": "section-faq",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Frequently asked questions" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Everything you need to know before you order" },
    { "type": "checkbox", "id": "alt_bg", "label": "Fundo alternativo", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pergunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pergunta", "default": "How long does delivery take?" },
        { "type": "richtext", "id": "answer", "label": "Resposta", "default": "<p>Orders are dispatched within 1–2 working days. You'll receive a tracking link by email as soon as your order ships.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perguntas frequentes",
      "blocks": [
        { "type": "question", "settings": { "question": "How long does delivery take?", "answer": "<p>Orders are dispatched within 1–2 working days. You'll receive a tracking link by email as soon as your order ships.</p>" } },
        { "type": "question", "settings": { "question": "Is checkout secure?", "answer": "<p>Yes. Our store is SSL encrypted and payments are processed by certified providers. We never see or store your card details.</p>" } },
        { "type": "question", "settings": { "question": "Can I return my order?", "answer": "<p>Yes. You have 14 days from delivery to return your order for a full refund, in line with the UK Consumer Contracts Regulations.</p>" } },
        { "type": "question", "settings": { "question": "Which payment methods do you accept?", "answer": "<p>All major credit and debit cards, Apple Pay, Google Pay and PayPal.</p>" } }
      ]
    }
  ]
}
{% endschema %}
